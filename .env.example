# Razorpay webhook secret for local development
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Development/demo database (docker compose service "db")
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/payment_recovery

# Disposable test database (docker compose --profile test up -d db_test).
# Integration/API tests read ONLY this variable and refuse dev/demo databases.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5434/payment_recovery_test

# Dashboard, /static and /api/v1 HTTP Basic credentials. Both must be set; there are no defaults.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Host header values the server accepts (comma-separated). A configured list replaces the default.
ALLOWED_HOSTS=localhost,127.0.0.1

# Serve /docs, /redoc and /openapi.json (behind the dashboard credentials) only when true.
ENABLE_API_DOCS=false

# PayPal REST API (sandbox app credentials from developer.paypal.com).
# PAYPAL_ENVIRONMENT defaults to sandbox; set it to "live" only to use production.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
